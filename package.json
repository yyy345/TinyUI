{
  "name": "my-elem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/tiny-element.umd.js",
  "module": "dist/tiny-element.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/tiny-element.js",
      "require": "./dist/tiny-element.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:lib": "vite build --mode lib && vue-tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "npm run server:build && node server/dist/app.js",
    "ai:start": "npm run server:start",
    "ai:doctor": "npm run server:build && node server/dist/scripts/doctor.js",
    "rag:doctor": "npm run server:build && node server/dist/scripts/doctor.js",
    "rag:index": "npm run server:build && node server/dist/scripts/reindex.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.0.6",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.0.5",
    "@popperjs/core": "^2.11.8",
    "@types/lodash-es": "^4.17.12",
    "@vitepress-demo-preview/component": "^2.3.2",
    "@vitepress-demo-preview/plugin": "^1.2.2",
    "async-validator": "^4.2.5",
    "express": "^4.22.1",
    "highlight.js": "^11.11.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.1",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.56.0",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^24.0.0",
    "patch-package": "^8.0.0",
    "postcss-nested": "^6.0.1",
    "sass": "^1.70.0",
    "sass-loader": "^14.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-eslint": "^1.8.1",
    "vitepress": "^1.0.0-rc.40",
    "vitest": "^1.2.1",
    "vue-tsc": "^1.8.25"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "postinstall": "patch-package"
}
